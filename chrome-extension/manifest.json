{
  "manifest_version": 3,
  "name": "Nesmi",
  "version": "1.0.0",
  "description": "Open Nesmi and keep household tasks within reach.",
  "action": {
    "default_title": "Nesmi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nesmi-16.png",
      "32": "icons/nesmi-32.png"
    }
  },
  "permissions": [],
  "icons": {
    "16": "icons/nesmi-16.png",
    "32": "icons/nesmi-32.png",
    "48": "icons/nesmi-48.png",
    "128": "icons/nesmi-128.png"
  }
}
